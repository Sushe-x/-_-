        "status": "as_documented",
        "note": "源文档《LEC法.docx》采用的四级划分，把 <70 统一归为低风险；使用时须在企业管理文件中固定口径。",
        "levels": [
          {
            "level": "重大风险（极其危险）",
            "risk_level": "重大风险",
            "min": 320,
            "max": null,
            "min_inclusive": false,
            "action": "不能继续作业，须立即整改"
          },
          {
            "level": "较大风险（高度危险）",
            "risk_level": "较大风险",
            "min": 160,
            "max": 320,
            "min_inclusive": true,
            "action": "需立即或近期采取措施降低风险"
          },
          {
            "level": "一般风险（显著危险）",
            "risk_level": "一般风险",
            "min": 70,
            "max": 160,
            "min_inclusive": true,
            "action": "需要整改，可考虑建立操作规程与培训"
          },
          {
            "level": "低风险（一般危险）",
            "risk_level": "低风险",
            "min": 0,
            "max": 70,
            "min_inclusive": true,
            "action": "需注意但通常无需立即停工，保持关注即可"
          }
        ]
      }
    ],
    "boundary_note": "两套口径在 D=70 与 D=20 处存在差异：源文档将 20≤D<70 并入低风险；经典划分将其单列为“一般危险”。D=320 与 D=160 的归属一致（均为左闭右开）。"
  },
