{
  "$schema": "./schema.json#/definitions/lec",
  "kb_version": "1.0.0",
  "method": {
    "id": "M-LEC",
    "name": "作业条件危险性评价法（LEC法）",
    "name_en": "Graham-Kinney Method",
    "origin": "由美国安全专家格雷厄姆（Graham）和金尼（Kinney）提出",
    "type": "半定量安全评价方法",
    "formula": "D = L × E × C",
    "purpose": "衡量操作人员在潜在危险环境中作业时的危险性，并对风险排序",
    "scope": "适用于评价单一作业活动（如动火、高处作业、进入受限空间），不适合反映整个系统的复杂风险关联",
    "limitations": [
      "主观性明显：L、E、C 的取值高度依赖评价人员经验，不同人打分可能偏差较大",
      "“伪定量”争议：三个序数性分值相乘，数学意义并不严谨，结果宜作相对排序工具，不宜当作精确概率",
      "仅适用于局部作业：无法反映整个系统的复杂风险关联"
    ],
    "good_practice": [
      "由熟悉现场的小组共同打分并取均值",
      "与 JSA/HAZOP 等定性方法组合使用",
      "企业应在安全管理文件中明确所采用的等级阈值"
    ]
  },
  "parameters": {
    "L": {
      "label": "事故发生的可能性",
      "unit": "无量纲",
      "table": [
        {
          "value": 10,
          "text": "完全可以预料"
        },
        {
          "value": 6,
          "text": "相当可能"
        },
        {
          "value": 3,
          "text": "可能，但不经常"
        },
        {
          "value": 1,
          "text": "可能性小，完全意外"
        },
        {
          "value": 0.5,
          "text": "很不可能，可以设想"
        },
        {
          "value": 0.2,
          "text": "极不可能"
        },
        {
          "value": 0.1,
          "text": "实际不可能"
        }
      ]
    },
    "E": {
      "label": "暴露于危险环境的频繁程度",
      "unit": "无量纲",
      "table": [
        {
          "value": 10,
          "text": "连续暴露"
        },
        {
          "value": 6,
          "text": "每天工作时间内暴露"
        },
        {
          "value": 3,
          "text": "每周一次或偶然暴露"
        },
        {
          "value": 2,
          "text": "每月一次暴露"
        },
        {
          "value": 1,
          "text": "每年几次暴露"
        },
        {
          "value": 0.5,
          "text": "非常罕见地暴露"
        }
      ]
    },
    "C": {
      "label": "发生事故可能造成的后果",
      "unit": "无量纲",
      "table": [
        {
          "value": 100,
          "text": "大灾难，许多人死亡"
        },
        {
          "value": 40,
          "text": "灾难，数人死亡"
        },
        {
          "value": 15,
          "text": "非常严重，一人死亡"
        },
        {
          "value": 7,
          "text": "严重，重伤"
        },
        {
          "value": 3,
          "text": "重大，致残"
        },
        {
          "value": 1,
          "text": "引人注目，需要救护"
        }
      ]
    }
  },
