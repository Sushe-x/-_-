          "std": "STD-GB51428-2021"
        },
        {
          "text": "厂内运输车辆限速、设置人行通道与警示标志。",
          "std": "STD-GB51428-2021"
        }
      ],
      "emergency_ids": [
        "E-06"
      ],
      "lec_id": "L-U01-03",
      "provenance": {
