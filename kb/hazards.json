    {
      "id": "H-U04-01",
      "unit_id": "U04",
      "title": "合成气火灾爆炸（重大）",
      "category": "爆炸",
      "gb6441_class": "其他爆炸",
      "occupational": false,
      "emphasis": "重大风险",
      "risk_rank": "核心",
      "mechanism": "气化炉为高温高压反应设备，介质一氧化碳、氢气爆炸极限范围宽。设备、管道腐蚀磨损泄漏后，合成气遇空气、点火源即发生燃烧爆炸；停车置换不彻底，空气窜入气化炉会发生炉内爆燃。",
      "media": [
        "CO",
        "H₂",
        "粗合成气"
      ],
      "consequences": [
        "燃爆",
        "炉内爆燃",
        "人员伤亡",
        "装置损毁"
      ],
      "targets": [
        "人员",
        "设备",
        "停产"
      ],
      "detection": [
        "可燃气体探测报警",
        "压力/温度联锁",
        "氧含量监测（置换）"
      ],
      "limits": [
        "LMT-LEL_CO",
        "LMT-LEL_H2",
        "LMT-PURGE_O2_MAX"
      ],
      "control_supplements": [
        {
          "text": "气化框架、压缩机房等按 GB 50160-2008 划分爆炸危险区域并设置可燃气体探测。",
          "std": "STD-GB50160-2008"
        },
        {
          "text": "开停车严格执行氮气置换，置换合格（可燃气体与氧含量达标）后方可投料或动火。",
          "std": "STD-GB30871-2022"
        },
        {
          "text": "设置安全联锁与紧急停车系统（ESD），超温超压自动切断。",
          "std": "STD-GB51428-2021"
        },
        {
          "text": "检修动火前办理动火作业票，动火点可燃气体浓度合格。",
          "std": "STD-GB30871-2022"
        }
      ],
      "emergency_ids": [
        "E-01",
        "E-02",
        "E-04"
      ],
      "lec_id": "L-U04-01",
      "provenance": {
        "doc": "煤制天然气工艺危险源分析.docx",
        "locator": "四、1"
      }
    },
    {
      "id": "H-U04-02",
      "unit_id": "U04",
      "title": "有毒物质中毒（CO、H₂S）",
      "category": "中毒和窒息",
      "gb6441_class": "中毒和窒息",
      "occupational": false,
      "emphasis": "重大风险",
      "risk_rank": "核心",
      "mechanism": "粗合成气含有高浓度一氧化碳、硫化氢。设备法兰、阀门、烧嘴密封失效泄漏，可造成人员急性中毒甚至死亡；检修未彻底置换，进入受限空间极易中毒。",
      "media": [
        "CO",
        "H₂S"
      ],
      "consequences": [
        "急性中毒",
        "昏迷",
        "死亡"
      ],
      "targets": [
        "人员"
      ],
      "detection": [
        "CO/H₂S 有毒气体探测报警",
        "密闭空间检测",
        "便携式检测仪"
      ],
      "limits": [
        "LMT-OEL_CO_TWA",
        "LMT-OEL_CO_STEL",
        "LMT-OEL_H2S_MAC"
      ],
      "control_supplements": [
        {
          "text": "按 GB/T 50493-2019 在可能泄漏点设置 H₂S、CO 有毒气体探测器，报警信号送中控室。",
          "std": "STD-GBT50493-2019"
        },
        {
          "text": "进入受限空间前检测氧含量、可燃气体与有毒气体，合格并办理作业票后方可进入。",
          "std": "STD-GB30871-2022"
        },
        {
          "text": "配备正压式空气呼吸器与便携式四合一检测仪，作业全程监护。",
          "std": "STD-GB39800.1-2020"
        }
      ],
      "emergency_ids": [
        "E-01",
        "E-03"
