        "温度/打滑监测"
      ],
      "limits": [
        "LMT-DUST_LEL_COAL"
      ],
      "control_supplements": [
        {
          "text": "输煤廊道设置除尘与清扫制度，积尘厚度受控。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "皮带机设置防打滑、防跑偏、防堵塞与急停装置。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "廊道内电气设备按粉尘爆炸危险区域选型并可靠接地。",
          "std": "STD-GB50058-2014"
        }
      ],
      "emergency_ids": [
