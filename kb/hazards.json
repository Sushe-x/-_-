{
  "$schema": "./schema.json#/definitions/hazards",
  "kb_version": "1.0.0",
  "ordering_rule": "按工艺顺序 U01→U11；单元内按原文档列举顺序；emphasis 保留原文标注（重大重点/重点/一般）。",
  "hazards": [
    {
      "id": "H-U01-01",
      "unit_id": "U01",
      "title": "煤堆自燃火灾",
      "category": "火灾",
      "gb6441_class": "火灾",
      "occupational": false,
      "emphasis": "重点",
      "risk_rank": "次要",
      "mechanism": "原煤、煤粉堆积，氧化蓄热易发生煤堆自燃，产生一氧化碳有毒烟气，引发火灾。",
      "media": [
        "原煤"
      ],
      "consequences": [
        "煤场火灾",
        "CO 有毒烟气扩散",
        "供煤中断"
      ],
      "targets": [
        "人员",
        "设备",
        "环境"
      ],
      "detection": [
        "煤堆温度监测",
        "CO 气体探测",
        "红外测温/巡测"
      ],
      "limits": [
        "LMT-OEL_CO_TWA"
      ],
      "control_supplements": [
        {
          "text": "煤场按分区堆存、控制堆高与堆存时间，定期倒堆降温。",
          "std": "STD-GB51428-2021"
        },
        {
          "text": "煤场设置消防给水与灭火器材，保持消防通道畅通。",
          "std": "STD-GB51428-2021"
        },
        {
          "text": "煤场作业区严禁明火与吸烟，动火须办理作业票。",
          "std": "STD-GB30871-2022"
        }
      ],
      "emergency_ids": [
        "E-02",
        "E-06"
      ],
      "lec_id": "L-U01-01",
      "provenance": {
        "doc": "煤制天然气工艺危险源分析.docx",
        "locator": "一、1"
      }
    },
    {
      "id": "H-U01-02",
      "unit_id": "U01",
      "title": "煤尘爆炸",
      "category": "粉尘爆炸",
      "gb6441_class": "其他爆炸",
      "occupational": false,
      "emphasis": "重点",
      "risk_rank": "次要",
      "mechanism": "卸料、堆料作业产生大量煤尘，达到爆炸极限遇点火源会发生粉尘爆炸。",
      "media": [
        "煤尘"
      ],
      "consequences": [
        "粉尘爆炸",
        "伴随火焰传播与二次爆炸",
        "建筑物损毁"
      ],
      "targets": [
        "人员",
        "设备"
      ],
      "detection": [
        "粉尘浓度监测",
        "防爆电气与静电接地检查"
      ],
      "limits": [
        "LMT-DUST_LEL_COAL"
      ],
      "control_supplements": [
        {
          "text": "煤尘爆炸危险场所按 GB 15577-2018 采取泄爆、隔爆、抑爆等控爆措施。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "除尘系统采用防爆型设备，风管设置泄爆装置，禁止使用非防爆电气。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "作业区定期清扫积尘，禁止用压缩空气吹扫，防止形成粉尘云。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "按爆炸危险区域划分选用电气设备。",
          "std": "STD-GB50058-2014"
        }
      ],
      "emergency_ids": [
        "E-02",
        "E-03"
      ],
      "lec_id": "L-U01-02",
      "provenance": {
        "doc": "煤制天然气工艺危险源分析.docx",
        "locator": "一、2"
      }
    },
    {
