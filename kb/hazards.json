    {
      "id": "H-U03-01",
      "unit_id": "U03",
      "title": "煤粉爆炸（重大）",
      "category": "粉尘爆炸",
      "gb6441_class": "其他爆炸",
      "occupational": false,
      "emphasis": "重大重点",
      "risk_rank": "核心",
      "mechanism": "磨煤机产出干燥超细煤粉，煤粉属于爆炸性粉尘。磨煤机内部积粉、过热、外来火源，极易发生煤粉爆炸、闪燃，可串燃至煤仓。",
      "media": [
        "煤粉"
      ],
      "consequences": [
        "煤粉爆炸",
        "闪燃",
        "串燃至煤仓",
        "设备与建构筑物损毁"
      ],
      "targets": [
        "人员",
        "设备"
      ],
      "detection": [
        "磨煤机出口温度",
        "煤粉仓温度/CO",
        "惰性气体（N₂）保护",
        "氧含量"
      ],
      "limits": [
        "LMT-DUST_LEL_COAL",
        "LMT-INERT_O2_MAX"
      ],
      "control_supplements": [
        {
          "text": "磨煤制粉系统设置惰性气体保护，控制氧含量在限值以下。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "煤粉仓、除尘器设置泄爆装置，管道设置隔爆/阻火装置。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "严格控制磨煤机出口温度与积粉，设置超温报警联锁。",
          "std": "STD-GB15577-2018"
        },
        {
          "text": "煤粉系统电气设备按粉尘爆炸危险区域选型。",
          "std": "STD-GB50058-2014"
        }
      ],
      "emergency_ids": [
        "E-02",
        "E-03"
      ],
      "lec_id": "L-U03-01",
      "provenance": {
        "doc": "煤制天然气工艺危险源分析.docx",
        "locator": "三、1"
      }
    },
