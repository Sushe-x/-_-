{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kb.coal-to-sng.local/schema.json",
  "title": "煤制天然气工艺安全知识库 Schema",
  "version": "1.0.0",
  "description": "面向网页端 AI 的结构化知识库契约。任何生成或修改 kb/*.json 的程序必须满足本 Schema；网页端只读取已通过校验的数据。",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^(U[0-9]{2}|H-U[0-9]{2}-[0-9]{2}|L-U[0-9]{2}-[0-9]{2}|E-[0-9]{2}|E-[0-9]{2}-S[0-9]+|STD-[A-Za-z0-9.\\-]+|LMT-[A-Z0-9_]+|M-[A-Z0-9]+|X-[0-9]{3}|GAP-[A-Z]-[0-9]{2})$",
      "description": "全局唯一标识。规则：U=工艺单元，H=危险源，L=LEC 行，E=应急场景/步骤，STD=标准，LMT=限值，M=介质，X=核对结论，GAP=缺口。"
    },
    "riskRank": { "type": "string", "enum": ["核心", "主要", "次要", "轻微"], "description": "风险分层，取自原文档“整体危险源总结”" },
    "riskLevel": { "type": "string", "enum": ["重大风险", "较大风险", "一般风险", "低风险"] },
    "lecLevel": { "type": "string", "enum": ["极其危险", "高度危险", "显著危险", "一般危险", "稍有危险"] },
    "emphasis": { "type": "string", "enum": ["重大重点", "重大风险", "重点", "一般"], "description": "原文档中的强调标注，保留原文用词" },
    "hazardCategory": {
      "type": "string",
      "enum": ["火灾", "爆炸", "粉尘爆炸", "锅炉爆炸", "中毒和窒息", "机械伤害", "灼烫", "坍塌", "车辆伤害", "噪声", "粉尘", "低温伤害", "腐蚀", "触电", "高处坠落"]
    },
    "gb6441Class": {
      "type": ["string", "null"],
      "enum": ["物体打击", "车辆伤害", "机械伤害", "起重伤害", "触电", "淹溺", "灼烫", "火灾", "高处坠落", "坍塌", "冒顶片帮", "透水", "放炮", "火药爆炸", "瓦斯爆炸", "锅炉爆炸", "容器爆炸", "其他爆炸", "中毒和窒息", "其他伤害", null],
      "description": "映射到 GB 6441-1986 的 20 类伤亡事故类别；职业健康类危害（噪声、粉尘）无对应类别，置 null。"
    },
    "provenance": {
      "type": "object",
      "required": ["doc", "locator"],
      "properties": {
        "doc": { "type": "string", "description": "来源文档文件名，必须是 source_docs 中的四个文件之一" },
        "locator": { "type": "string", "description": "章节或表格位置，如“四、2”“工序说明 5”" },
        "quote": { "type": "string", "description": "可选：原文摘录，用于溯源比对" }
      },
      "additionalProperties": false
    },
    "standardRef": {
      "type": "object",
      "required": ["std"],
      "properties": {
        "std": { "$ref": "#/definitions/id", "description": "标准 ID，须存在于 standards.json" },
        "clause": { "type": "string", "description": "条款号；未核实时为空字符串，禁止臆造" },
        "note": { "type": "string", "description": "该标准与本条目的关联说明" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low", "unverified"] }
      },
      "additionalProperties": false
    },
    "limitRef": {
      "type": "string",
      "pattern": "^LMT-[A-Z0-9_]+$",
      "description": "限值 ID，须存在于 limits.json"
    },
    "process_units": {
      "type": "object",
      "required": ["kb_version", "units", "links"],
      "properties": {
        "kb_version": { "type": "string" },
        "units": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "required": ["id", "order", "stage", "name", "summary", "media_in", "media_out", "hazard_ids", "risk_rank", "is_key_unit", "provenance"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "order": { "type": "integer", "minimum": 1, "maximum": 11 },
              "stage": { "type": "string", "enum": ["main", "auxiliary"], "description": "main=主流程（1~9），auxiliary=配套单元（10~11）" },
              "name": { "type": "string" },
              "short_name": { "type": "string" },
              "summary": { "type": "string" },
              "equipment": { "type": "array", "items": { "type": "object", "required": ["name", "role"], "properties": { "name": { "type": "string" }, "role": { "type": "string" } } } },
              "media_in": { "type": "array", "items": { "type": "string" } },
              "media_out": { "type": "array", "items": { "type": "string" } },
              "conditions": { "type": "object", "properties": { "temperature": { "type": "string" }, "pressure": { "type": "string" } } },
              "hazard_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
              "risk_rank": { "$ref": "#/definitions/riskRank" },
              "is_key_unit": { "type": "boolean" },
              "key_reason": { "type": "string" },
              "standard_refs": { "type": "array", "items": { "$ref": "#/definitions/standardRef" } },
              "emergency_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
              "image_ref": { "type": "string" },
              "provenance": { "$ref": "#/definitions/provenance" }
            }
          }
        },
        "links": {
          "type": "array",
          "description": "单元间物料/公用工程/副产物连接，构成流程图有向图",
          "items": {
            "type": "object",
            "required": ["from", "to", "medium", "type"],
            "properties": {
              "from": { "$ref": "#/definitions/id" },
              "to": { "$ref": "#/definitions/id" },
              "medium": { "type": "string" },
              "type": { "type": "string", "enum": ["material", "utility", "byproduct", "wastewater", "recycle"] }
            }
          }
        }
      }
    },
    "hazards": {
      "type": "object",
      "required": ["kb_version", "hazards"],
      "properties": {
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "unit_id", "title", "category", "gb6441_class", "occupational", "emphasis", "risk_rank", "mechanism", "consequences", "provenance"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "unit_id": { "$ref": "#/definitions/id" },
              "title": { "type": "string" },
              "category": { "$ref": "#/definitions/hazardCategory" },
              "gb6441_class": { "$ref": "#/definitions/gb6441Class" },
              "occupational": { "type": "boolean", "description": "true=职业健康类有害因素（噪声、粉尘），无伤亡事故类别" },
              "emphasis": { "$ref": "#/definitions/emphasis" },
              "risk_rank": { "$ref": "#/definitions/riskRank" },
              "mechanism": { "type": "string" },
              "media": { "type": "array", "items": { "type": "string" } },
              "consequences": { "type": "array", "items": { "type": "string" } },
              "targets": { "type": "array", "items": { "type": "string", "enum": ["人员", "设备", "环境", "停产", "周边"] } },
              "detection": { "type": "array", "items": { "type": "string" } },
              "limits": { "type": "array", "items": { "$ref": "#/definitions/limitRef" } },
              "control_supplements": {
                "type": "array",
                "description": "由国标核对后补充的控制措施，与原文内容严格区分",
                "items": {
                  "type": "object",
                  "required": ["text", "std"],
                  "properties": { "text": { "type": "string" }, "std": { "$ref": "#/definitions/id" } }
                }
              },
              "emergency_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
              "lec_id": { "$ref": "#/definitions/id" },
              "provenance": { "$ref": "#/definitions/provenance" }
            }
          }
        }
      }
    },
    "lec": {
      "type": "object",
      "required": ["method", "parameters", "grading", "assessments"],
      "properties": {
        "method": { "type": "object", "required": ["formula"], "properties": { "formula": { "type": "string", "const": "D = L × E × C" } } },
        "parameters": {
          "type": "object",
          "required": ["L", "E", "C"],
          "properties": {
            "L": { "$ref": "#/definitions/lecParam" },
            "E": { "$ref": "#/definitions/lecParam" },
            "C": { "$ref": "#/definitions/lecParam" }
          }
        },
        "grading": {
          "type": "object",
          "required": ["schemes"],
          "properties": { "schemes": { "type": "array", "items": { "$ref": "#/definitions/lecScheme" } } }
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "unit_id", "hazard_id", "L", "E", "C", "D", "value_status"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "unit_id": { "$ref": "#/definitions/id" },
              "hazard_id": { "$ref": "#/definitions/id" },
              "L": { "type": "number", "enum": [0.1, 0.2, 0.5, 1, 2, 3, 6, 10] },
              "E": { "type": "number", "enum": [0.5, 1, 2, 3, 6, 10] },
              "C": { "type": "number", "enum": [1, 3, 7, 15, 40, 100] },
              "D": { "type": "number", "description": "必须等于 L×E×C；由计算得出，禁止人工填写" },
              "level": { "$ref": "#/definitions/lecLevel" },
              "risk_level": { "$ref": "#/definitions/riskLevel" },
              "control": { "type": "string" },
              "value_status": { "type": "string", "enum": ["source_example", "suggested", "reviewed"], "description": "reviewed=经企业风险评价小组评审确认，才可用于正式报告" }
            }
          }
        }
      }
    },
    "lecParam": {
      "type": "object",
      "required": ["table"],
      "properties": {
        "table": {
          "type": "array",
          "items": { "type": "object", "required": ["value", "text"], "properties": { "value": { "type": "number" }, "text": { "type": "string" } } }
        }
      }
    },
    "lecScheme": {
      "type": "object",
      "required": ["id", "levels"],
      "properties": {
        "id": { "type": "string" },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "risk_level", "min", "max", "action"],
            "properties": {
              "level": { "$ref": "#/definitions/lecLevel" },
              "risk_level": { "$ref": "#/definitions/riskLevel" },
              "min": { "type": "number" },
              "max": { "type": ["number", "null"] },
              "min_inclusive": { "type": "boolean" },
              "action": { "type": "string" }
            }
          }
        }
      }
    },
    "emergency": {
      "type": "object",
      "required": ["scenarios", "roles"],
      "properties": {
        "scenarios": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": ["id", "order", "name", "trigger", "steps"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "order": { "type": "integer" },
              "name": { "type": "string" },
              "trigger": { "type": "string" },
              "priority": { "type": "string" },
              "hazard_ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "phase", "action", "role_source"],
                  "properties": {
                    "id": { "$ref": "#/definitions/id" },
                    "phase": { "type": "string" },
                    "action": { "type": "string" },
                    "role": { "type": ["string", "null"], "description": "原文明确的责任岗位；原文未写明时为 null" },
                    "role_source": { "type": "string", "enum": ["source", "not_specified"] },
                    "suggested_role": { "type": "string", "description": "仅当 role_source=not_specified 时给出的建议岗位，不得当作原文内容引用" },
                    "type": { "type": "string", "enum": ["prohibition", "action"] }
                  }
                }
              },
              "standards": { "type": "array", "items": { "$ref": "#/definitions/id" } }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": ["limits"],
      "properties": {
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "value", "unit", "type", "std"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "name": { "type": "string" },
              "value": { "type": ["number", "string"] },
              "value_max": { "type": "number" },
              "unit": { "type": "string" },
              "type": { "type": "string", "enum": ["OEL", "爆炸极限", "报警设定值", "作业环境", "工艺控制"] },
              "std": { "$ref": "#/definitions/id" },
              "clause": { "type": "string" },
              "applies_to": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "string", "enum": ["high", "medium", "low", "unverified"] },
              "review": {
                "type": "object",
                "required": ["status"],
                "description": "复核状态；pending 表示尚未由持证工程师对照标准正文确认，网页端必须显示“待复核”",
                "properties": {
                  "status": { "type": "string", "enum": ["pending", "confirmed", "revised", "not_required"] },
                  "reviewer": { "type": "string" },
                  "date": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "standards": {
      "type": "object",
      "required": ["standards"],
      "properties": {
        "standards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "code", "title", "status", "role"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "code": { "type": "string", "description": "标准号，如 GB 30871-2022" },
              "title": { "type": "string" },
              "status": { "type": "string", "enum": ["现行", "被代替", "废止", "未核实"] },
              "replaced_by": { "type": "string" },
              "publish_date": { "type": "string" },
              "effective_date": { "type": "string" },
              "issuer": { "type": "string" },
              "scope": { "type": "string", "description": "一句话说明在本知识库中承担的作用" },
              "role": { "type": "string", "enum": ["防火防爆", "危险源与风险", "职业健康", "特殊作业", "应急管理", "环境保护", "设备与管道", "产品与工艺"] },
              "source_url": { "type": "string" },
              "verification": { "type": "string", "enum": ["official_registry", "publisher", "secondary", "unverified"] },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
            }
          }
        }
      }
    },
    "major_hazard": {
      "type": "object",
      "required": ["standard", "method", "grading", "media_thresholds", "unit_worksheets"],
      "properties": {
        "status": { "type": "string", "enum": ["tool_ready_data_pending", "partial", "complete"] },
        "standard": { "$ref": "#/definitions/id" },
        "method": {
          "type": "object",
          "required": ["formula", "symbols", "steps"],
          "properties": {
            "formula": { "type": "string", "const": "R = α × Σ ( β_i × q_i / Q_i )" },
            "symbols": {
              "type": "array",
              "items": { "type": "object", "required": ["symbol", "meaning", "unit"], "properties": { "symbol": { "type": "string" }, "meaning": { "type": "string" }, "unit": { "type": "string" } } }
            },
            "steps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "grading": {
          "type": "object",
          "required": ["levels"],
          "properties": {
            "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
            "levels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["level", "min", "action"],
                "properties": {
                  "level": { "type": "string" },
                  "min": { "type": "number" },
                  "max": { "type": ["number", "null"] },
                  "min_inclusive": { "type": "boolean" },
                  "action": { "type": "string" }
                }
              }
            }
          }
        },
        "media_thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["medium_id", "Q_status"],
            "properties": {
              "medium_id": { "$ref": "#/definitions/id" },
              "Q": { "type": ["number", "null"], "description": "临界量；未取得标准正文时必须为 null" },
              "beta": { "type": ["number", "null"] },
              "Q_status": { "type": "string", "enum": ["pending", "filled", "verified"] }
            }
          }
        },
        "unit_worksheets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit_id", "media", "q_entries"],
            "properties": {
              "unit_id": { "$ref": "#/definitions/id" },
              "media": { "type": "array", "items": { "$ref": "#/definitions/id" } },
              "q_entries": { "type": "array" }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "required": ["phases", "actions"],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "goal", "exit_criteria"],
            "properties": {
              "id": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
              "name": { "type": "string" },
              "goal": { "type": "string" },
              "exit_criteria": { "type": "string" },
              "owner": { "type": "string" }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "phase", "owner", "priority", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^A-[0-9]{3}$" },
              "finding_id": { "type": ["string", "null"], "description": "关联 crosswalk.json 的 X-xxx" },
              "title": { "type": "string" },
              "phase": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
              "owner": { "type": "string" },
              "priority": { "type": "string", "enum": ["高", "中", "低"] },
              "due": { "type": "string" },
              "deliverable": { "type": "string" },
              "status": { "type": "string", "enum": ["open", "doing", "done", "blocked"] }
            }
          }
        }
      }
    },
    "step_risks": {
      "type": "object",
      "required": ["categories", "steps"],
      "properties": {
        "kb_version": { "type": "string" },
        "module": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "steps": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "required": ["unit_id", "step", "name", "possible", "impossible"],
            "properties": {
              "unit_id": { "$ref": "#/definitions/id" },
              "step": { "type": "integer", "minimum": 1, "maximum": 11 },
              "name": { "type": "string" },
              "summary": { "type": "string" },
              "possible": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["cat"],
                  "properties": {
                    "cat": { "type": "string", "description": "必须属于 categories" },
                    "hazard_id": { "type": ["string", "null"], "description": "关联 hazards.json；为空时必须写 note" },
                    "plan": { "type": "array", "items": { "$ref": "#/definitions/id" }, "description": "关联 emergency.json 的场景 ID" },
                    "note": { "type": "string" }
                  }
                }
              },
              "impossible": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["cat", "reason"],
                  "properties": {
                    "cat": { "type": "string" },
                    "reason": { "type": "string", "description": "为什么在该工艺条件下不可能发生" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "required": ["findings"],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "target", "claim", "verdict", "standards"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "target": { "type": "string", "description": "被核对的对象：U/H/L/E 的 ID 或“全文”" },
              "claim": { "type": "string", "description": "源文档的原始表述" },
              "verdict": { "type": "string", "enum": ["符合", "部分符合", "需补充", "需修订", "无法核实"] },
              "standards": { "type": "array", "items": { "$ref": "#/definitions/id" } },
              "clause": { "type": "string" },
              "evidence": { "type": "string", "description": "标准要求与源文档的差异说明" },
              "action": { "type": "string", "description": "修订或补充建议" },
              "severity": { "type": "string", "enum": ["高", "中", "低"] }
            }
          }
        }
      }
    }
  }
}
